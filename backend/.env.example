# LEX AI - Backend Environment
# Copie este arquivo para .env e preencha os valores.

# --- Banco de dados (PostgreSQL gerenciado - Neon/Supabase/Railway) ---
# Neon: crie um projeto em https://neon.tech e use a connection string "pooled" ou "direct".
# A URL do Neon termina em ".neon.tech/<db>?sslmode=require". Exemplo:
# DATABASE_URL=postgresql://usuario:senha@ep-nome.region.aws.neon.tech/lexai?sslmode=require
DATABASE_URL=postgresql+asyncpg://lexai:lexai@localhost:5432/lexai

# --- Redis (Upstash / Redis Cloud - connection string com TLS) ---
# Upstash: crie um banco em https://upstash.com e use a connection string "rediss://".
# Exemplo: rediss://default:<token>@<host>.upstash.io:6379
REDIS_URL=rediss://default:change-me@change-me.upstash.io:6379

# --- Segurança ---
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
BCRYPT_ROUNDS=12

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- IA / OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
AI_PROVIDER=openai

# --- Banco Vetorial (Qdrant Cloud / local) ---
# Qdrant Cloud: https://cloud.qdrant.io - crie um cluster e gere uma API key.
# VECTOR_STORE=qdrant
# QDRANT_URL=https://xxxx.sa-east-1-0.aws.cloud.qdrant.io
# QDRANT_API_KEY=<sua-api-key>
# Para modo local (desenvolvimento, sem servidor): QDRANT_LOCAL=true e QDRANT_PATH=./data/qdrant
VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=lexai_documents
QDRANT_LOCAL=true
QDRANT_PATH=./data/qdrant
CHROMA_PERSIST_DIR=./data/chroma

# --- Supabase (opcional) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Rate limit ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.png,.jpg,.jpeg,.tiff,.txt

# --- E-mail (Resend) ---
# Crie uma API key em https://resend.com/api-keys
# RESEND_API_KEY=re_xxxx
# EMAIL_FROM=LEX AI <onboarding@resend.dev>
# APP_URL=http://localhost:3000

# --- Mercado Pago (assinaturas) ---
# Token de acesso: https://www.mercadopago.com.br/developers - aplicação -> credenciais.
# Em produção use o token com prefíxo APP_USR-. Para testes use TEST- e crie uma
# conta de teste com e-mail próprio (não o do vendedor).
# MP_ACCESS_TOKEN=APP_USR-xxxxxxxx
# MP_PUBLIC_KEY=APP_USR-xxxxxxxx
# BACKEND_URL=http://localhost:8000
# PLANO_PRO_PRECO=97.0
# PLANO_EMPRESA_PRECO=297.0

# --- App ---
APP_NAME=LEX AI
APP_ENV=development
DEBUG=true
